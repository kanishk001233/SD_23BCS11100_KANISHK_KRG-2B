        <mxCell id="8fItc524EqqVUBgxHqu4-394" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Examination Service" vertex="1">
