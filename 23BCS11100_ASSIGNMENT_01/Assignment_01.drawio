        <mxCell id="8fItc524EqqVUBgxHqu4-251" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;text-align: center; text-wrap-mode: nowrap;&quot;&gt;Problem: -&lt;font style=&quot;&quot;&gt;&amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Admin wants:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Average score,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Subject-wise analysis,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Year-wise trends&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;These queries are &lt;/span&gt;&lt;span data-start=&quot;2156&quot; data-end=&quot;2165&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;heavy and&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;font-size: 15px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;run on &lt;/span&gt;&lt;span data-start=&quot;2180&quot; data-end=&quot;2193&quot; style=&quot;font-size: 15px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Result DB&amp;nbsp;(Read-heavy + analytics-heavy on same DB)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span data-start=&quot;2180&quot; data-end=&quot;2193&quot; style=&quot;font-size: 15px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span data-start=&quot;2180&quot; data-end=&quot;2193&quot; style=&quot;font-size: 15px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Analytics queries slow down normal user queries,&amp;nbsp;Poor performance for students&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="687" x="60" y="6640" as="geometry" />
        </mxCell>
        <mxCell id="8fItc524EqqVUBgxHqu4-252" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;To support analytics without impacting transactional performance, read replicas are used to offload heavy read queries from the primary database.&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="997" x="57.18" y="6760" as="geometry" />
        </mxCell>
